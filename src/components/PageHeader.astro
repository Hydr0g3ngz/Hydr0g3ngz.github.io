---
interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
}

const { eyebrow, heading, description } = Astro.props;
---
<section class="page-hero wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{heading}</h1>
  {description && <p>{description}</p>}
</section>
