---
import type { ProfileBlock } from '../../content-schema';

interface Props {
  block: ProfileBlock;
}

const { block } = Astro.props;
---
<section id={block.id} class="page-profile wrap">
  <div class="about-main">
    {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  {block.facts.length > 0 && (
    <aside class="facts">
      {block.facts.map((fact) => (
        <div>
          <span>{fact.label}</span>
          <strong>
            {fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}
          </strong>
        </div>
      ))}
    </aside>
  )}
</section>
<style>
  .facts a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; overflow-wrap: anywhere; }
  .facts a:hover { text-decoration-color: currentColor; }
  .facts a:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
</style>
