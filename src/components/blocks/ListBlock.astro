---
import type { ListBlock } from '../../content-schema';

interface Props {
  block: ListBlock;
}

const { block } = Astro.props;
---
{block.presentation === 'posters' ? (
  <section id={block.id} tabindex={block.id ? -1 : undefined} class="screen-list wrap" aria-label={block.heading}>
    <header class="screen-group-heading">
      {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
      <h2>{block.heading}</h2>
      {block.intro && <p>{block.intro}</p>}
    </header>
    <div class="screen-entries">
      {block.items.map((item) => (
        <article class:list={['screen-entry', { 'screen-entry--text': !item.image }]} data-image-source={item.imageSourceUrl}>
          {item.image && <figure class="screen-poster"><img src={item.image} alt={item.imageAlt || `Poster for ${item.title}`} width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" /></figure>}
          <div class="screen-copy">
            <div class="screen-entry-heading">
              {item.meta && <p class="screen-meta">{item.meta}</p>}
              <h3>{item.href ? <a href={item.href} target={item.href.startsWith('https://') ? '_blank' : undefined} rel={item.href.startsWith('https://') ? 'noopener noreferrer' : undefined} aria-label={item.href.startsWith('https://') ? `${item.title} (opens in a new tab)` : undefined}><span>{item.title}</span> <span class="screen-link-arrow" aria-hidden="true" data-studio-ignore>↗</span></a> : item.title}</h3>
            </div>
            <p class="screen-summary">{item.text}</p>
            {item.favoriteTrack && <p class="list-favorite"><span class="list-favorite-label" data-studio-ignore>Favorite song</span><span>{item.favoriteTrack}</span></p>}
          </div>
        </article>
      ))}
    </div>
  </section>
) : (
<section id={block.id} tabindex={block.id ? -1 : undefined} class:list={['section', 'list-section', 'wrap', { 'film-list-section': block.id === 'film-list' }]}>
  <div class="content-section-head">
    {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
    <h2>{block.heading}</h2>
    {block.intro && <p class="list-intro">{block.intro}</p>}
  </div>
  <div class:list={['content-list-grid', `columns-${block.columns}`]}>
    {block.items.map((item, index) => (
      <article class="content-list-item" data-index={String(index + 1).padStart(2, '0')}>
        {item.meta && <p class="tag">{item.meta}</p>}
        <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
        <p>{item.text}</p>
        {item.favoriteTrack && <p class="list-favorite"><span class="list-favorite-label" data-studio-ignore>Favorite song</span><span>{item.favoriteTrack}</span></p>}
      </article>
    ))}
  </div>
</section>
)}

<style>
  .screen-list { padding-top: 52px; }
  .screen-list, .list-section { scroll-margin-top: 28px; }
  .screen-list:focus-visible, .list-section:focus-visible { outline: 1px solid var(--muted); outline-offset: 8px; }
  .screen-list#musicals .screen-group-heading h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); }
  .screen-list + .screen-list { padding-top: 48px; }
  .screen-list:last-child { padding-bottom: 88px; }
  .screen-group-heading { margin-bottom: 20px; }
  .screen-group-heading h2 { font: 400 1.65rem/1.25 Georgia, serif; }
  .screen-group-heading > p:not(.eyebrow) { max-width: 65ch; margin: 12px 0 0; color: var(--muted); }
  .screen-entries { border-top: 1px solid var(--line); }
  .screen-entry { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 28px; align-items: center; padding-block: 24px; border-bottom: 1px solid var(--line); }
  .screen-entry--text { grid-template-columns: 1fr; }
  .screen-poster { width: 100%; aspect-ratio: 2 / 3; margin: 0; background: var(--soft); }
  .screen-poster img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .screen-copy { min-width: 0; }
  .screen-meta { margin: 0 0 8px; color: var(--muted); font-size: .78rem; line-height: 1.5; }
  .screen-entry h3 { margin: 0; font: italic 400 1.55rem/1.3 Georgia, serif; letter-spacing: -.015em; }
  .screen-entry h3 a { display: inline-flex; align-items: baseline; gap: .5rem; max-width: 100%; }
  .screen-entry h3 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .screen-entry h3 a:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
  .screen-link-arrow { flex-shrink: 0; color: var(--muted); font: normal .85rem/1 system-ui, sans-serif; }
  .screen-summary { max-width: 72ch; margin: 14px 0 0; color: var(--muted); font-size: .96rem; line-height: 1.65; }
  .list-favorite { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .75rem; margin: 14px 0 0; color: var(--ink); font: 400 1rem/1.5 Georgia, serif; }
  .list-favorite-label { color: var(--muted); font: 400 .75rem/1.5 var(--font-sans, Inter, sans-serif); }
  @media (max-width: 560px) {
    .screen-list { padding-top: 38px; }
    .screen-list + .screen-list { padding-top: 36px; }
    .screen-list:last-child { padding-bottom: 64px; }
    .screen-entry { grid-template-columns: 78px minmax(0, 1fr); gap: 16px 20px; align-items: center; }
    .screen-copy { display: contents; }
    .screen-entry h3 { font-size: 1.3rem; }
    .screen-summary { grid-column: 1 / -1; margin: 0; }
    .screen-entry .list-favorite { grid-column: 1 / -1; margin: 0; }
    .screen-entry--text { grid-template-columns: 1fr; }
  }
</style>
