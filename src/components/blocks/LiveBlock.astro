---
import type { LiveBlock } from '../../content-schema';

interface Props {
  block: LiveBlock;
}

const { block } = Astro.props;
---
<section id={block.id} tabindex={block.id ? -1 : undefined} class="section live-section wrap">
  <header class="live-heading">
    <p class="eyebrow">{block.eyebrow}</p>
    <h2>{block.heading}</h2>
    <p>{block.intro}</p>
  </header>

  {block.records.length > 0 ? (
    <div class="live-grid" data-live-gallery>
      {block.records.map((record, index) => (
        <figure class="live-record">
          <div class="live-image">
            {record.video ? (
              <a class="live-open" data-live-open href={record.video} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${record.title}${record.track ? ` — ${record.track}` : ''}`}>
                <img src={record.image} alt={record.imageAlt} width={record.imageWidth} height={record.imageHeight} loading="lazy" />
                <span class="live-watch" aria-hidden="true"><svg viewBox="0 0 12 14" width="10" height="12"><path d="M1 1L11 7L1 13Z" fill="currentColor" /></svg> Watch clip</span>
              </a>
            ) : (
              <img
                src={record.image}
                alt={record.imageAlt}
                width={record.imageWidth}
                height={record.imageHeight}
                loading="lazy"
              />
            )}
            <span class="live-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <figcaption>
            {(record.date || record.venue) && <p class="live-meta">{[record.date, record.venue].filter(Boolean).join(' · ')}</p>}
            <h3>{record.title}</h3>
            {record.track && <p class="live-track">Song: {record.track}</p>}
            {record.artist && <p class="live-artist">{record.artist}</p>}
            {record.note && <p class="live-note">{record.note}</p>}
          </figcaption>
          {record.video && (
            <dialog class="live-dialog" aria-label={`${record.title}${record.track ? ` — ${record.track}` : ''}`} data-studio-ignore>
              <header class="live-player-heading">
                <p>{record.title}{record.track && <span> — {record.track}</span>}</p>
                <form method="dialog"><button type="submit">Close <span aria-hidden="true">×</span></button></form>
              </header>
              <video controls playsinline preload="none" width={record.imageWidth} height={record.imageHeight} poster={record.image} aria-label={`Concert clip: ${record.title}${record.track ? ` performing ${record.track}` : ''}`}>
                <source src={record.video} type={record.video.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
                <a href={record.video}>Open the concert clip</a>
              </video>
              {(record.date || record.venue) && <p class="live-player-meta">{[record.date, record.venue].filter(Boolean).join(' · ')}</p>}
            </dialog>
          )}
        </figure>
      ))}
    </div>
  ) : (
    <div class="live-empty">
      <span aria-hidden="true">＋</span>
      <p>{block.emptyNote}</p>
    </div>
  )}
</section>

<script>
  import { mountLiveGallery } from '../../lib/live-gallery.mjs';
  document.querySelectorAll('[data-live-gallery]').forEach(mountLiveGallery);
</script>

<style>
  .live-section { padding-top: 88px; scroll-margin-top: 28px; }
  .live-section:focus-visible { outline: none; }
  .live-section:focus-visible .live-heading .eyebrow { text-decoration: underline; text-underline-offset: 5px; }
  .live-heading { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: 54px; align-items: end; margin-bottom: 44px; }
  .live-heading .eyebrow { grid-column: 1; }
  .live-heading h2 { grid-column: 1; font-size: clamp(2.6rem, 4.3vw, 4rem); line-height: 1.02; }
  .live-heading > p:last-child { grid-column: 2; grid-row: 2; max-width: 540px; margin: 0; color: var(--muted); font-size: 1rem; }
  .live-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 24px; align-items: start; }
  .live-record { min-width: 0; margin: 0; }
  .live-image { position: relative; aspect-ratio: 4 / 3; background: #0d0d0c; }
  .live-open { position: relative; display: block; width: 100%; height: 100%; }
  .live-open::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 55%, rgba(0, 0, 0, .64)); pointer-events: none; }
  .live-open:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
  .live-image img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 30%; filter: saturate(.72) contrast(.98); }
  .live-open:hover img { filter: saturate(1) contrast(1); }
  .live-watch { position: absolute; z-index: 1; left: 14px; bottom: 12px; display: flex; align-items: center; gap: 8px; color: #fff; font-size: .76rem; }
  .live-number { position: absolute; right: 10px; top: 8px; color: #fff; font: .72rem Georgia, serif; text-shadow: 0 1px 8px #000; pointer-events: none; }
  .live-record figcaption { padding-top: 17px; }
  .live-meta { margin: 0; color: var(--muted); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; }
  .live-record h3 { margin-top: 8px; font: 1.35rem/1.2 Georgia, serif; }
  .live-track, .live-artist, .live-note { margin: 6px 0 0; color: var(--muted); font-size: .88rem; }
  .live-note { line-height: 1.65; }
  .live-dialog { width: fit-content; max-width: calc(100vw - 32px); max-height: calc(100dvh - 32px); margin: auto; padding: 16px; border: 0; background: var(--paper); color: var(--ink); box-shadow: 0 16px 80px #0006; }
  .live-dialog::backdrop { background: rgba(13, 13, 12, .8); backdrop-filter: blur(3px); }
  .live-dialog video { display: block; width: auto; height: auto; max-width: min(1000px, calc(100vw - 64px)); max-height: calc(100dvh - 180px); margin-inline: auto; object-fit: contain; background: #0d0d0c; }
  .live-player-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 12px; }
  .live-player-heading p { min-width: 0; max-width: 44ch; margin: 0; font: 1rem/1.5 Georgia, serif; }
  .live-player-heading p span { color: var(--muted); }
  .live-player-heading button { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 6px; border: 0; background: none; color: var(--ink); font: inherit; font-size: .8rem; cursor: pointer; }
  .live-player-heading button span { font-size: 1.5rem; }
  .live-player-heading button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .live-player-meta { margin: 12px 0 0; color: var(--muted); font-size: .75rem; }
  :global(html:has(.live-dialog[open])) { overflow: hidden; }
  .live-empty { min-height: 180px; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 24px; padding: 28px; border-block: 1px solid var(--line); color: var(--muted); }
  .live-empty span { font: 2.6rem/1 Georgia, serif; color: var(--ink); }
  .live-empty p { max-width: 430px; margin: 0; font: italic 1.2rem/1.5 Georgia, serif; }
  @media (max-width: 1080px) { .live-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .live-heading { display: block; }
    .live-heading > p:last-child { margin-top: 20px; }
    .live-empty { min-height: 140px; padding-inline: 0; }
  }
  @media (max-width: 560px) { .live-grid { grid-template-columns: 1fr; } }
</style>
