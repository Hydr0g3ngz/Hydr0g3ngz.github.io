---
import type { ReadingBlock } from '../../content-schema';
interface Props { block: ReadingBlock; }
const { block } = Astro.props;
---
<section id={block.id} class="section culture-section reading-section wrap">
  <div class="culture-heading">
    <p class="eyebrow">{block.eyebrow}</p>
    <h2>{block.heading}</h2>
    <p>{block.intro}</p>
  </div>
  {block.books.length > 0 && <div class="book-grid">
    {block.books.map((book, index) => <article class="book-card">
      <div class:list={['book-jacket', `jacket-${book.color}`]} aria-hidden="true">
        <span class="jacket-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="jacket-title">{book.title}</span>
        <span class="jacket-rule"></span>
        <span class="jacket-author">{book.author}</span>
      </div>
      <div class="book-copy">
        <p class="culture-meta">{book.author}</p>
        <h3>{book.title}</h3>
        {book.originalTitle && <p class="book-original" lang="zh-CN">{book.originalTitle}</p>}
        <ul class="book-themes" aria-label="Themes">{book.themes.map(theme => <li>{theme}</li>)}</ul>
        <p class="book-blurb">{book.blurb}</p>
        <a class="culture-source" href={book.sourceUrl} target="_blank" rel="noopener noreferrer">{book.sourceLabel}<span aria-hidden="true"> ↗</span></a>
        {book.reflection && <div class="personal-reflection"><p class="eyebrow">WILL’S MARGIN NOTE</p><p>{book.reflection}</p></div>}
      </div>
    </article>)}
  </div>}
  {block.excerpts.length > 0 && <div class="commonplace poetry-collection">
    <div class="commonplace-heading">
      <p class="eyebrow">SONG CI · COMPLETE TEXTS</p>
      <h2>Poems to return to.</h2>
      <p>Song ci in full, with room for both stanzas. Each text links back to its source.</p>
    </div>
    <div class="excerpt-list poem-grid">{block.excerpts.map((excerpt, index) => <figure class="excerpt-card poem-card">
      <figcaption class="poem-caption">
        <p class="poem-byline"><span class="poem-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{excerpt.author}</span></p>
        <h3 lang="zh-Hans"><cite>{excerpt.work}</cite></h3>
      </figcaption>
      <blockquote class="poem-stanzas" lang="zh-Hans" cite={excerpt.sourceUrl}>
        {excerpt.text.split(/\n\s*\n/).map(stanza => <p class="excerpt-original">{stanza}</p>)}
      </blockquote>
      {excerpt.translation?.trim() && <p class="excerpt-translation">{excerpt.translation}</p>}
      <a class="culture-source poem-source" href={excerpt.sourceUrl} target="_blank" rel="noopener noreferrer">{excerpt.sourceLabel}<span aria-hidden="true"> ↗</span></a>
      {excerpt.reflection && <div class="personal-reflection"><p class="eyebrow">WILL’S MARGIN NOTE</p><p>{excerpt.reflection}</p></div>}
    </figure>)}</div>
  </div>}
</section>
