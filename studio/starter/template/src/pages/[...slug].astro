---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlockRenderer from '../components/BlockRenderer.astro';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.published);

  return pages.map((page) => ({
    params: { slug: page.id.replace(/\/index$/, '') },
    props: { page }
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
---
<Base title={`${page.data.title}`} description={page.data.description}>
  <PageHeader eyebrow={page.data.eyebrow} heading={page.data.heading} />
  {page.data.sections.map((block) => <BlockRenderer block={block} />)}
</Base>
