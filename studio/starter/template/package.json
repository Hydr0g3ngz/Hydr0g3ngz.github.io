{
  "name": "my-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:output": "node scripts/validate-output.mjs",
    "build": "npm run validate:content && npm run check && astro build && npm run validate:output",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.2.10",
    "marked": "18.0.12",
    "sanitize-html": "2.17.7",
    "js-yaml": "5.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "@types/sanitize-html": "2.16.1",
    "typescript": "6.0.3"
  }
}
